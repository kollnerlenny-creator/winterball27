rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          'admin@winterball27.de',
          'charlotte@winterball27.de',
          'gruenbergel2019@gymwilsdruff.lernsax.de',
          'lenny.koellner@gmail.com',
          'pauline@winterball27.de'
        ]
        || request.auth.uid == 'ylF8dIY0PXgl9Zellmj5APIUTzn2'
      );
    }

    function deadlineOk() {
      return !exists(/databases/$(database)/documents/settings/deadline)
        || get(/databases/$(database)/documents/settings/deadline).data.timestamp == null
        || (get(/databases/$(database)/documents/settings/deadline).data.timestamp is string);
    }

    function opensAtOk() {
      return !exists(/databases/$(database)/documents/settings/opensAt)
        || get(/databases/$(database)/documents/settings/opensAt).data.timestamp == null
        || (get(/databases/$(database)/documents/settings/opensAt).data.timestamp is string);
    }

    match /registrations/{regId} {
      // Jeder darf sich selbst anmelden (unbezahlt, nur mit Name und E-Mail).
      // Admins dürfen jederzeit manuell Bestellungen anlegen.
      allow create: if (request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.name.size() <= 200
                        && request.resource.data.email is string
                        && request.resource.data.email.size() > 3
                        && request.resource.data.email.size() <= 254
                        && request.resource.data.paid == false
                        && (!('companions' in request.resource.data)
                            || (request.resource.data.companions is list && request.resource.data.companions.size() <= 25))
                        && deadlineOk()
                        && opensAtOk())
                    || isAdmin();

      // Read/Update/Delete ausschließlich für freigegebene Admins (Duplikatsprüfung & Status-Check laufen über den Worker).
      allow read, update, delete: if isAdmin();
    }

    match /vorabstimmung/{id} {
      allow create: if request.resource.data.keys().size() <= 12;
      allow read, update, delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      // Tickets dürfen bei der Anmeldung erzeugt werden (müssen unbezahlt & uneingecheckt sein).
      allow create: if (request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.name.size() <= 200
                        && request.resource.data.email is string
                        && request.resource.data.email.size() > 3
                        && request.resource.data.email.size() <= 254
                        && request.resource.data.ticketId is string
                        && request.resource.data.ticketId.size() > 0
                        && request.resource.data.ticketId.size() <= 64
                        && request.resource.data.category in ['u18', 'ue18']
                        && request.resource.data.paid == false
                        && request.resource.data.checkedIn == false)
                    || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      // Öffentliche Anzeigeeinstellungen dürfen von Gästen gelesen werden.
      allow get: if docId == 'info' || docId == 'deadline' || docId == 'opensAt' || docId == 'lernsaxThreshold' || docId == 'pricing' || docId == 'schedule' || docId == 'stats' || docId == 'capacity' || docId == 'maintenance' || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();

      // Live-Ticketzähler: darf beim Anmelden um max. 25 Tickets pro Bestellung erhöht werden.
      allow update: if docId == 'stats'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketCount'])
                    && request.resource.data.ticketCount is int
                    && request.resource.data.ticketCount >= resource.data.ticketCount
                    && request.resource.data.ticketCount <= resource.data.ticketCount + 25;
    }

    match /ratings/{ratingId} {
      // Sternebewertungen (1-5 Sterne) öffentlich abgebbar.
      allow create: if request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string && request.resource.data.comment.size() <= 2000));
      allow read, update, delete: if isAdmin();
    }
  }
}
